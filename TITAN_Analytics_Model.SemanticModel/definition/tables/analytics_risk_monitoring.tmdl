table analytics_risk_monitoring
	lineageTag: ce33968c-8fcf-4e50-acf0-caa79fe58ff5
	sourceLineageTag: [dbo].[analytics_risk_monitoring]

	measure 'High Risk Decisions' =
			
			CALCULATE(
			    COUNTROWS(analytics_risk_monitoring),
			    analytics_risk_monitoring[risk_level] = "HIGH"
			)
		formatString: 0
		lineageTag: 62bab056-b883-4cd2-be83-020a88053d79

		changedProperty = Name

	measure 'Pending Approvals' =
			
			CALCULATE(
			    COUNTROWS(analytics_risk_monitoring),
			    analytics_risk_monitoring[action_status] = "PENDING_APPROVAL"
			)
		formatString: 0
		lineageTag: fca72db3-9516-45dc-8b68-623eae36985c

		changedProperty = Name

	measure 'Open Actions' =
			
			CALCULATE(
			    COUNTROWS(analytics_risk_monitoring),
			    analytics_risk_monitoring[action_status] = "OPEN"
			)
		formatString: 0
		lineageTag: 464cd89f-4cc9-4747-96f4-e66a1ca5e858

		changedProperty = Name

