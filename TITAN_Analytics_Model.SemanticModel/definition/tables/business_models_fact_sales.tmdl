table business_models_fact_sales
	lineageTag: 20467709-96ee-4bf7-97cf-5b08852a4cec
	sourceLineageTag: [dbo].[business_models_fact_sales]

	measure 'Total Revenue' =
			
			SUM ( business_models_fact_sales[Total_Item_Value] )
		lineageTag: bcec3100-d37f-4c08-ac6c-2bd244854e4a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' =
			
			DISTINCTCOUNT ( business_models_fact_sales[Order_ID] )
		formatString: 0
		lineageTag: e0e3e723-89f9-4ee5-b1b5-67c7252fa1f6

		changedProperty = Name

	measure 'Total Customers' =
			
			DISTINCTCOUNT ( business_models_fact_sales[Customer_SK] )
		formatString: 0
		lineageTag: 9d685a4d-12bb-4aba-8556-20495ab63031

		changedProperty = Name

	measure 'Total Products' =
			
			DISTINCTCOUNT ( business_models_fact_sales[Product_SK] )
		formatString: 0
		lineageTag: 85ff8e8f-ae62-42cd-9142-ba18a5950072

		changedProperty = Name

	measure 'Total Sellers' =
			
			DISTINCTCOUNT ( business_models_fact_sales[Seller_SK] )
		formatString: 0
		lineageTag: a2b67dec-8bcc-41d4-9663-e16fcbeeebc8

		changedProperty = Name

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Revenue],
			    [Total Orders]
			)
		lineageTag: de9f4749-aa25-45cb-9254-b34142c1bcca

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Delivery Days' =
			
			AVERAGE(
			    business_models_fact_sales[Delivery_Days]
			)
		lineageTag: d0584356-9a31-46b1-9fc7-ee0b1bf0e0f6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Review Score' =
			
			AVERAGE(
			    business_models_fact_sales[Review_Score]
			)
		lineageTag: 3206d8e2-7e52-44ed-a139-715c311558a4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Free Shipping %' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(business_models_fact_sales),
			        business_models_fact_sales[Is_Free_Shipping] = TRUE()
			    ),
			    COUNTROWS(business_models_fact_sales)
			)
		lineageTag: 7f785cbe-82b1-4c3c-b6a5-24e09fd0502f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delayed Deliveries' =
			
			CALCULATE(
			    COUNTROWS(business_models_fact_sales),
			    business_models_fact_sales[Delivery_Status] = "Delayed"
			)
		formatString: 0
		lineageTag: e214c7f4-ddf1-47ea-80ec-9102c180dae7

		changedProperty = Name

